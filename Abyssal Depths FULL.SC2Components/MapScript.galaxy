bool lib3977487D_gt_IsChristmasTime_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    playergroup autoB525AB99_g;
    int autoB525AB99_var;
    unitgroup auto0EB5FA8D_g;
    int auto0EB5FA8D_u;
    unit auto0EB5FA8D_var;

    // Conditions
    if (testConds) {
        if (!((((GetDateTimeMonth(CurrentDateTimeGet()) == 12) && ((GetDateTimeDay(CurrentDateTimeGet()) >= 18) && (GetDateTimeDay(CurrentDateTimeGet()) <= 31))) || ((GetDateTimeMonth(CurrentDateTimeGet()) == 1) && ((GetDateTimeDay(CurrentDateTimeGet()) >= 1) && (GetDateTimeDay(CurrentDateTimeGet()) <= 1)))))) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    lib3977487D_gv_isChristmasTime = true;
    autoB525AB99_g = PlayerGroupAll();
    autoB525AB99_var = -1;
    while (true) {
        autoB525AB99_var = PlayerGroupNextPlayer(autoB525AB99_g, autoB525AB99_var);
        if (autoB525AB99_var < 0) { break; }
        libCOMI_gf_PlayerApplySkinSignal(autoB525AB99_var, "HalloweenSkins2", true, "");
        libNtve_gf_SetUpgradeLevelForPlayer(autoB525AB99_var, "ChristmasTime", 1);
    }
    auto0EB5FA8D_g = UnitGroup(null, c_playerAny, RegionEntireMap(), UnitFilter((1 << c_targetFilterBiological), 0, (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))), 0);
    auto0EB5FA8D_u = UnitGroupCount(auto0EB5FA8D_g, c_unitCountAll);
    for (;; auto0EB5FA8D_u -= 1) {
        auto0EB5FA8D_var = UnitGroupUnitFromEnd(auto0EB5FA8D_g, auto0EB5FA8D_u);
        if (auto0EB5FA8D_var == null) { break; }
        UnitBehaviorAdd(auto0EB5FA8D_var, "ChristmasHatEquipped", auto0EB5FA8D_var, 1);
    }
    TriggerEnable(lib3977487D_gt_ApplyChristmasHats, true);
    return true;
}

