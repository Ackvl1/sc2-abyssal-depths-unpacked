// Trigger: Is Haloween Time
//--------------------------------------------------------------------------------------------------
bool lib3977487D_gt_IsHaloweenTime_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    playergroup autoAF28ED5E_g;
    int autoAF28ED5E_var;

    // Conditions
    if (testConds) {
        if (!((((GetDateTimeMonth(CurrentDateTimeGet()) == 10) && ((GetDateTimeDay(CurrentDateTimeGet()) >= 24) && (GetDateTimeDay(CurrentDateTimeGet()) <= 31))) || ((GetDateTimeMonth(CurrentDateTimeGet()) == 11) && ((GetDateTimeDay(CurrentDateTimeGet()) >= 1) && (GetDateTimeDay(CurrentDateTimeGet()) <= 7)))))) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    lib3977487D_gv_isHalloweenTime = true;
    autoAF28ED5E_g = PlayerGroupAll();
    autoAF28ED5E_var = -1;
    while (true) {
        autoAF28ED5E_var = PlayerGroupNextPlayer(autoAF28ED5E_g, autoAF28ED5E_var);
        if (autoAF28ED5E_var < 0) { break; }
        libCOMI_gf_PlayerApplySkinSignal(autoAF28ED5E_var, "HalloweenSkins", true, "");
        SoundtrackPlay(PlayerGroupAll(), c_soundtrackCategoryAmbience, "Ambience_Halloween", c_soundtrackCueAny, c_soundtrackIndexAny, false);
    }
    return true;
}

