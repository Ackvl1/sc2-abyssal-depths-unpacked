    // Automatic Variable Declarations
    // Actions
    if (!runActions) {
        return true;
    }

    DialogControlHookupStandard(c_triggerControlTypePanel, "UIContainer");
    lib3977487D_gv_frostOverlayDialog = DialogControlLastCreated();
    DialogControlHookup(lib3977487D_gv_frostOverlayDialog, c_triggerControlTypeImage, "BorderScreenIceCover");
    lib3977487D_gv_frostOverlayDialogItem = DialogControlLastCreated();
    DialogControlFadeTransparency(lib3977487D_gv_frostOverlayDialogItem, PlayerGroupAll(), 0.0, 100.0);
    DialogControlSetVisible(lib3977487D_gv_frostOverlayDialogItem, PlayerGroupAll(), true);
    DialogControlHookup(lib3977487D_gv_frostOverlayDialog, c_triggerControlTypeImage, "FullScreenIceCover");
    lib3977487D_gv_heavyFrostOverlayDialogItem = DialogControlLastCreated();
    DialogControlFadeTransparency(lib3977487D_gv_heavyFrostOverlayDialogItem, PlayerGroupAll(), 0.0, 100.0);
    DialogControlSetVisible(lib3977487D_gv_heavyFrostOverlayDialogItem, PlayerGroupAll(), true);
    return true;
}

