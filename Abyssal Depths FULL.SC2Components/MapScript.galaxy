//--------------------------------------------------------------------------------------------------
// Trigger: Pet Rescue Start
//--------------------------------------------------------------------------------------------------
bool lib3977487D_gt_PetRescueStart_Func (bool testConds, bool runActions) {
    // Variable Declarations
    unit lv_pet;

    // Automatic Variable Declarations
    // Variable Initialization
    lv_pet = lib3977487D_gv_playerPets[UnitGetOwner(EventUnitTargetUnit())];

    // Conditions
    if (testConds) {
        if (!((UnitGetType(EventUnitTargetUnit()) == "InfestedCocoon"))) {
            return false;
        }

        if (!((UnitGetType(lv_pet) == "CovertOpsRaven"))) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    UnitIssueOrder(lv_pet, OrderTargetingUnit(AbilityCommand("PetRescue", 0), EventUnitTargetUnit()), c_orderQueueReplace);
    return true;
}

