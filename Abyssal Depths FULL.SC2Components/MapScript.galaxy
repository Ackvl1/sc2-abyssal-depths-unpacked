        SoundPlayAtPointForPlayer(SoundLink("UI_NovaEquipment_PulseGrenade", -1), EventPlayer(), PlayerGroupSingle(EventPlayer()), UnitGetPosition(lv_marine), 0.0, 100.0, 0.0);
        libNtve_gf_SetUpgradeLevelForPlayer(EventPlayer(), "ForceFieldGrenadeEquipped", 1);
        libNtve_gf_SetUpgradeLevelForPlayer(EventPlayer(), "FragGrenadeEquipped", 0);
        libNtve_gf_SetUpgradeLevelForPlayer(EventPlayer(), "FlashBangEquipped", 0);
        libNtve_gf_SetUpgradeLevelForPlayer(EventPlayer(), "IncendiaryGrenadeEquipped", 0);
    }
    else if (auto8A1DF3BB_val == "FragGrenadeUnlocked") {
        SoundPlayAtPointForPlayer(SoundLink("UI_NovaEquipment_PulseGrenade", -1), EventPlayer(), PlayerGroupSingle(EventPlayer()), UnitGetPosition(lv_marine), 0.0, 100.0, 0.0);
        libNtve_gf_SetUpgradeLevelForPlayer(EventPlayer(), "FragGrenadeEquipped", 1);
        libNtve_gf_SetUpgradeLevelForPlayer(EventPlayer(), "ForceFieldGrenadeEquipped", 0);
        libNtve_gf_SetUpgradeLevelForPlayer(EventPlayer(), "FlashBangEquipped", 0);
        libNtve_gf_SetUpgradeLevelForPlayer(EventPlayer(), "IncendiaryGrenadeEquipped", 0);
    }
    else if (auto8A1DF3BB_val == "IncendiaryGrenadeUnlocked") {
        SoundPlayAtPointForPlayer(SoundLink("UI_NovaEquipment_PulseGrenade", -1), EventPlayer(), PlayerGroupSingle(EventPlayer()), UnitGetPosition(lv_marine), 0.0, 100.0, 0.0);
        libNtve_gf_SetUpgradeLevelForPlayer(EventPlayer(), "IncendiaryGrenadeEquipped", 1);
        libNtve_gf_SetUpgradeLevelForPlayer(EventPlayer(), "FragGrenadeEquipped", 0);
        libNtve_gf_SetUpgradeLevelForPlayer(EventPlayer(), "ForceFieldGrenadeEquipped", 0);
        libNtve_gf_SetUpgradeLevelForPlayer(EventPlayer(), "FlashBangEquipped", 0);
