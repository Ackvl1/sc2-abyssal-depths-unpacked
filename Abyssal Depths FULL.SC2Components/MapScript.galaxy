//--------------------------------------------------------------------------------------------------
bool lib3977487D_gt_SelfDestruct_Func (bool testConds, bool runActions) {
    // Variable Declarations
    unit lv_marine;

    // Automatic Variable Declarations
    const int auto8EAAA139_n = 2;
    int auto8EAAA139_i;

    // Variable Initialization
    lv_marine = UnitCargo(EventUnit(), 1);

    // Actions
    if (!runActions) {
        return true;
    }

    UnitBehaviorRemove(EventUnit(), "AresExpandedCargo", 1);
    UnitBehaviorAdd(EventUnit(), "SelfDestruct", EventUnit(), 1);
    Wait(0.0625, c_timeGame);
    for (auto8EAAA139_i = 1; auto8EAAA139_i <= auto8EAAA139_n; auto8EAAA139_i += 1) {
        if ((UnitHasBehavior2(EventUnit(), "AresHasPassenger") == false)) {
            UnitSetPosition(lv_marine, PointWithOffsetPolar(UnitGetPosition(EventUnit()), -0.25, UnitGetFacing(EventUnit())), false);
            UnitBehaviorAdd(lv_marine, "ParachuteLaunch", EventUnit(), 1);
            UnitBehaviorAdd(lv_marine, "Parachute", EventUnit(), 1);
            libNtve_gf_SendActorMessageToUnit(lv_marine, "HostSiteOpsSet ::Host SOpMoveDownByDot75");
            break;
        }
        else {
            UnitBehaviorAdd(EventUnit(), "EjectingPassenger", EventUnit(), 1);
            UnitBehaviorRemove(EventUnit(), "AresHasPassenger", 1);
            Wait(0.5, c_timeGame);
        }
    }
    return true;
}

