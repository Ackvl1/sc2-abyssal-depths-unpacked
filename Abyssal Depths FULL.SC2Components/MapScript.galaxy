//--------------------------------------------------------------------------------------------------
// Trigger: Unit Created
//--------------------------------------------------------------------------------------------------
bool lib3977487D_gt_UnitCreated_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    // Conditions
    if (testConds) {
        if (!(((UnitGetOwner(EventUnitCreatedUnit()) == 10) || (PlayerGroupHasPlayer(lib3977487D_gv_humans, UnitGetOwner(EventUnitCreatedUnit())) == true)))) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    if ((UnitGetType(EventUnitCreatedUnit()) == "WarPig")) {
        if ((lib3977487D_gv_stimAutoCastOn[UnitGetOwner(EventUnitCreatedUnit())] == false)) {
            UnitIssueOrder(EventUnitCreatedUnit(), OrderSetAutoCast(AbilityCommand("Stimpack", 0), false), c_orderQueueAddToFront);
        }

        lib3977487D_gv_overloadAutoCastOn[UnitGetOwner(EventUnitCreatedUnit())] = false;
        if ((lib3977487D_gv_shieldMatrixAutoCastOn[UnitGetOwner(EventUnitCreatedUnit())] == false)) {
            UnitIssueOrder(EventUnitCreatedUnit(), OrderSetAutoCast(AbilityCommand("ActivateDefensiveMatrix", 0), false), c_orderQueueAddToFront);
        }

        if ((TechTreeUpgradeCount(UnitGetOwner(EventUnitCreatedUnit()), "FlamethrowerEquipped", c_techCountQueuedOrBetter) == 1)) {
            UnitWeaponRemove(EventUnitCreatedUnit(), "KelmorianMinerGaussRifle");
            UnitBehaviorRemove(EventUnitCreatedUnit(), "AssaultRifleEquipped", 1);
            UnitWeaponAdd(EventUnitCreatedUnit(), "DevilDogFlameThrower", null);
            UnitBehaviorAdd(EventUnitCreatedUnit(), "FlameThrowerEquipped", EventUnitCreatedUnit(), 1);
        }
        else if ((TechTreeUpgradeCount(UnitGetOwner(EventUnitCreatedUnit()), "BeamRifleEquipped", c_techCountQueuedOrBetter) == 1)) {
            UnitWeaponRemove(EventUnitCreatedUnit(), "KelmorianMinerGaussRifle");
            UnitBehaviorRemove(EventUnitCreatedUnit(), "AssaultRifleEquipped", 1);
            UnitWeaponAdd(EventUnitCreatedUnit(), "HighTemplarWeapon", "Marine");
            UnitBehaviorAdd(EventUnitCreatedUnit(), "PlasmaRifleEquipped", EventUnitCreatedUnit(), 1);
        }
        else if ((TechTreeUpgradeCount(UnitGetOwner(EventUnitCreatedUnit()), "UnknownUpgrade2", c_techCountQueuedOrBetter) == 1)) {
            UnitWeaponRemove(EventUnitCreatedUnit(), "KelmorianMinerGaussRifle");
            UnitBehaviorRemove(EventUnitCreatedUnit(), "AssaultRifleEquipped", 1);
            UnitWeaponAdd(EventUnitCreatedUnit(), "TyphoonMissilePod", null);
            UnitWeaponAdd(EventUnitCreatedUnit(), "HellfireRocketLauncherLongRange", null);
            UnitBehaviorAdd(EventUnitCreatedUnit(), "RocketLauncherEquipped", EventUnitCreatedUnit(), 1);
        }
        else if ((TechTreeUpgradeCount(UnitGetOwner(EventUnitCreatedUnit()), "Shotgunequipped", c_techCountQueuedOrBetter) == 1)) {
            UnitWeaponRemove(EventUnitCreatedUnit(), "KelmorianMinerGaussRifle");
            UnitBehaviorRemove(EventUnitCreatedUnit(), "AssaultRifleEquipped", 1);
            UnitWeaponAdd(EventUnitCreatedUnit(), "HellfireShotgun", null);
            UnitWeaponAdd(EventUnitCreatedUnit(), "HellfireShotgunBeams", null);
            UnitBehaviorAdd(EventUnitCreatedUnit(), "ShotgunEquipped", EventUnitCreatedUnit(), 1);
        }
        else if ((TechTreeUpgradeCount(UnitGetOwner(EventUnitCreatedUnit()), "ArcWelderEquipped", c_techCountQueuedOrBetter) >= 1)) {
            UnitWeaponRemove(EventUnitCreatedUnit(), "KelmorianMinerGaussRifle");
            UnitBehaviorRemove(EventUnitCreatedUnit(), "AssaultRifleEquipped", 1);
            UnitWeaponAdd(EventUnitCreatedUnit(), "ArcWelder", null);
            UnitBehaviorAdd(EventUnitCreatedUnit(), "ArcWelderEquipped", EventUnitCreatedUnit(), 1);
        }
        else if ((TechTreeUpgradeCount(UnitGetOwner(EventUnitCreatedUnit()), "PhasesaberEquipped", c_techCountQueuedOrBetter) >= 1)) {
            UnitWeaponRemove(EventUnitCreatedUnit(), "KelmorianMinerGaussRifle");
            UnitBehaviorRemove(EventUnitCreatedUnit(), "AssaultRifleEquipped", 1);
            UnitWeaponAdd(EventUnitCreatedUnit(), "Phasesaber", null);
            UnitBehaviorAdd(EventUnitCreatedUnit(), "PhasesaberEquipped", EventUnitCreatedUnit(), 1);
            UnitBehaviorAdd(EventUnitCreatedUnit(), "PhasesaberBlock", EventUnitCreatedUnit(), 1);
            if ((TechTreeUpgradeCount(UnitGetOwner(EventUnitCreatedUnit()), "PhasesaberMod1Equipped", c_techCountQueuedOrBetter) == 1)) {
                UnitBehaviorAdd(EventUnitCreatedUnit(), "PhasesaberDeflect", EventUnitCreatedUnit(), 1);
            }

        }
        if ((TechTreeUpgradeCount(UnitGetOwner(EventUnitCreatedUnit()), "LongRangeScopeEquipped", c_techCountQueuedOrBetter) == 1)) {
            UnitBehaviorAdd(EventUnitCreatedUnit(), "ScopeRangeBuff", EventUnitCreatedUnit(), 1);
        }

        if ((TechTreeUpgradeCount(UnitGetOwner(EventUnitCreatedUnit()), "AutoTargetingSystemEquipped", c_techCountQueuedOrBetter) == 1)) {
            UnitBehaviorAdd(EventUnitCreatedUnit(), "AutoTargetingSystemOnline", EventUnitCreatedUnit(), 1);
            if ((TechTreeUpgradeCount(UnitGetOwner(EventUnitCreatedUnit()), "AssaultRifleEquipped", c_techCountQueuedOrBetter) == 1)) {
                lib3977487D_gf_AutoTargetingAnimationsLoop(EventUnitCreatedUnit());
                UnitWeaponAdd(EventUnitCreatedUnit(), "AssaultRifleAutoTargetingSystem", null);
            }

        }

        if ((TechTreeUpgradeCount(UnitGetOwner(EventUnitCreatedUnit()), "CombatShieldEquipped", c_techCountQueuedOrBetter) == 1)) {
            UnitBehaviorAdd(EventUnitCreatedUnit(), "CombatShieldEquipped", EventUnitCreatedUnit(), 1);
        }

        if ((TechTreeUpgradeCount(UnitGetOwner(EventUnitCreatedUnit()), "MedicShieldEquipped", c_techCountQueuedOrBetter) == 1)) {
            UnitBehaviorAdd(EventUnitCreatedUnit(), "MedicShieldEquipped", EventUnitCreatedUnit(), 1);
        }

        if ((TechTreeUpgradeCount(UnitGetOwner(EventUnitCreatedUnit()), "EnergyPackEquipped", c_techCountQueuedOrBetter) == 1)) {
            UnitBehaviorAdd(EventUnitCreatedUnit(), "ExternalBatteryPackEquipped", EventUnitCreatedUnit(), 1);
        }

        if ((TechTreeUpgradeCount(UnitGetOwner(EventUnitCreatedUnit()), "QuantumBackpackEquipped", c_techCountQueuedOrBetter) == 1)) {
            UnitBehaviorAdd(EventUnitCreatedUnit(), "QuantumBackpack", EventUnitCreatedUnit(), 1);
        }

        if ((TechTreeUpgradeCount(UnitGetOwner(EventUnitCreatedUnit()), "StimpackEquipped", c_techCountQueuedOrBetter) == 1)) {
            UnitBehaviorAdd(EventUnitCreatedUnit(), "StimpackEquipped", EventUnitCreatedUnit(), 1);
        }

        if ((TechTreeUpgradeCount(UnitGetOwner(EventUnitCreatedUnit()), "TeleporterUnlocked", c_techCountQueuedOrBetter) == 1)) {
            UnitAbilityAdd(EventUnitCreatedUnit(), "Teleport");
            if ((UnitHasBehavior2(EventUnitCreatedUnit(), "EmergencyCloak") == true)) {
                UnitAbilityShow(EventUnitCreatedUnit(), "Teleport", false);
            }

        }
        else if ((TechTreeUpgradeCount(UnitGetOwner(EventUnitCreatedUnit()), "PowerConverterUnlocked", c_techCountQueuedOrBetter) == 1)) {
            UnitAbilityAdd(EventUnitCreatedUnit(), "PowerConverter");
            if ((UnitHasBehavior2(EventUnitCreatedUnit(), "EmergencyCloak") == true)) {
                UnitAbilityShow(EventUnitCreatedUnit(), "PowerConverter", false);
            }

        }
        else if ((TechTreeUpgradeCount(UnitGetOwner(EventUnitCreatedUnit()), "CloakingDeviceUnlocked", c_techCountQueuedOrBetter) == 1)) {
            UnitAbilityAdd(EventUnitCreatedUnit(), "CloakingDevice");
            if ((UnitHasBehavior2(EventUnitCreatedUnit(), "EmergencyCloak") == true)) {
                UnitAbilityShow(EventUnitCreatedUnit(), "CloakingDevice", false);
            }

        }
        else if ((TechTreeUpgradeCount(UnitGetOwner(EventUnitCreatedUnit()), "SuperStimpackUnlocked", c_techCountQueuedOrBetter) == 1)) {
            UnitAbilityAdd(EventUnitCreatedUnit(), "SuperStimpack");
            if ((UnitHasBehavior2(EventUnitCreatedUnit(), "EmergencyCloak") == true)) {
                UnitAbilityShow(EventUnitCreatedUnit(), "SuperStimpack", false);
            }

        }
        else if ((TechTreeUpgradeCount(UnitGetOwner(EventUnitCreatedUnit()), "SuperHealingDroneUnlocked", c_techCountQueuedOrBetter) == 1)) {
            UnitAbilityAdd(EventUnitCreatedUnit(), "CreateSuperHealingDrone");
            if ((UnitHasBehavior2(EventUnitCreatedUnit(), "EmergencyCloak") == true)) {
                UnitAbilityShow(EventUnitCreatedUnit(), "CreateSuperHealingDrone", false);
            }

        }
        else if ((TechTreeUpgradeCount(UnitGetOwner(EventUnitCreatedUnit()), "ArcWelderUnlocked", c_techCountQueuedOrBetter) == 1)) {
            UnitAbilityAdd(EventUnitCreatedUnit(), "Weld");
            if ((UnitHasBehavior2(EventUnitCreatedUnit(), "EmergencyCloak") == true)) {
                UnitAbilityShow(EventUnitCreatedUnit(), "Weld", false);
            }

        }
        else if ((TechTreeUpgradeCount(UnitGetOwner(EventUnitCreatedUnit()), "PhasesaberUnlocked", c_techCountQueuedOrBetter) == 1)) {
            UnitAbilityAdd(EventUnitCreatedUnit(), "PhaseDash");
            if ((UnitHasBehavior2(EventUnitCreatedUnit(), "EmergencyCloak") == true)) {
                UnitAbilityShow(EventUnitCreatedUnit(), "PhaseDash", false);
            }

        }
        UnitBehaviorAdd(EventUnitCreatedUnit(), "OwningPlayerNumber", EventUnitCreatedUnit(), UnitGetOwner(EventUnitCreatedUnit()));
        DialogControlHookupUnitStatus(c_triggerControlTypeLabel, "SomeCustomLabel", EventUnitCreatedUnit());
        libNtve_gf_SetDialogItemText(DialogControlLastCreated(), StringToText(lib3977487D_gv_patronTitle[UnitGetOwner(EventUnitCreatedUnit())]), PlayerGroupAll());
        libNtve_gf_SetDialogItemColor(DialogControlLastCreated(), lib3977487D_gv_patronColor[UnitGetOwner(EventUnitCreatedUnit())], PlayerGroupAll());
    }

    if ((lib3977487D_gv_powerOff == true)) {
        if ((UnitGetType(EventUnitCreatedUnit()) == "WarPig") && (TechTreeUpgradeCount(UnitGetOwner(EventUnitCreatedUnit()), "CombatSuitEquipped", c_techCountQueuedOrBetter) == 1)) {
            UnitBehaviorAdd(EventUnitCreatedUnit(), "EmergencyLights2", EventUnitCreatedUnit(), 1);
        }
        else {
            UnitBehaviorAdd(EventUnitCreatedUnit(), "EmergencyLights", EventUnitCreatedUnit(), 1);
        }
    }

