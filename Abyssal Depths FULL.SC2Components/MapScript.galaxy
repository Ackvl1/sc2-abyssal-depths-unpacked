//--------------------------------------------------------------------------------------------------
bool lib3977487D_gt_afk_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    unitgroup autoC569146C_g;
    int autoC569146C_u;
    unit autoC569146C_var;

    // Actions
    if (!runActions) {
        return true;
    }

    autoC569146C_g = UnitGroupFilterPlayer(lib3977487D_gv_marines, EventPlayer(), 0);
    autoC569146C_u = UnitGroupCount(autoC569146C_g, c_unitCountAll);
    for (;; autoC569146C_u -= 1) {
        autoC569146C_var = UnitGroupUnitFromEnd(autoC569146C_g, autoC569146C_u);
        if (autoC569146C_var == null) { break; }
        if ((UnitHasBehavior2(autoC569146C_var, "AutoHarvesting") == false)) {
            if (((TechTreeUnitCount(EventPlayer(), "MiningDroid", c_techCountCompleteOnly) == 0) || (UnitHasBehavior(autoC569146C_var, "ArcWelderEquipped") == true))) {
                UnitIssueOrder(autoC569146C_var, Order(AbilityCommand("stop", 0)), c_orderQueueReplace);
            }

            UnitBehaviorAdd(autoC569146C_var, "AutoHarvesting", autoC569146C_var, 1);
        }
        else {
            UnitBehaviorRemove(autoC569146C_var, "AutoHarvesting", 1);
            if (((TechTreeUnitCount(EventPlayer(), "MiningDroid", c_techCountCompleteOnly) == 0) || (UnitHasBehavior(autoC569146C_var, "ArcWelderEquipped") == true))) {
                UnitIssueOrder(autoC569146C_var, Order(AbilityCommand("stop", 0)), c_orderQueueReplace);
            }

        }
    }
    return true;
}

