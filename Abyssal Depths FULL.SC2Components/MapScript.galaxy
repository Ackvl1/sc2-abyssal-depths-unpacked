//--------------------------------------------------------------------------------------------------
// Trigger: Exploration Droid Built
//--------------------------------------------------------------------------------------------------
bool lib3977487D_gt_ExplorationDroidBuilt_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    // Conditions
    if (testConds) {
        if (!((UnitGetType(EventUnitCreatedUnit()) == "ExplorationDroid"))) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    if ((UnitGetType(UnitGroupUnit(UnitControlGroup(UnitGetOwner(EventUnitCreatedUnit()), 5), 1)) != "MiningDroid") && (UnitGetType(UnitGroupUnit(UnitControlGroup(UnitGetOwner(EventUnitCreatedUnit()), 5), 1)) != "NukePack") && (UnitGetType(UnitGroupUnit(UnitControlGroup(UnitGetOwner(EventUnitCreatedUnit()), 5), 1)) != "SensorTower") && (UnitGetType(UnitGroupUnit(UnitControlGroup(UnitGetOwner(EventUnitCreatedUnit()), 5), 1)) != "SuperHealingDrone")) {
        UnitControlGroupAddUnit(UnitGetOwner(EventUnitCreatedUnit()), 5, EventUnitCreatedUnit());
    }

    if ((lib3977487D_gf_IsPointInSublevel(UnitGetPosition(EventUnitCreatedUnit())) == true)) {
        UnitBehaviorAdd(EventUnitCreatedUnit(), "Frostbite", EventUnitCreatedUnit(), 1);
    }

    if ((TechTreeUpgradeCount(UnitGetOwner(EventUnitCreatedUnit()), "AdvancedExplorationDroid", c_techCountQueuedOrBetter) == 1)) {
        UnitBehaviorAdd(EventUnitCreatedUnit(), "AdvancedExplorationDroid", EventUnitCreatedUnit(), 1);
    }

    UnitIssueOrder(EventUnitCreatedUnit(), Order(AbilityCommand("GhostCloak", 0)), c_orderQueueReplace);
    lib3977487D_gv_newRankPoints[UnitGetOwner(EventUnitCreatedUnit())] += 15;
    lib3977487D_gf_UpdateStatsMenu();
    return true;
}

