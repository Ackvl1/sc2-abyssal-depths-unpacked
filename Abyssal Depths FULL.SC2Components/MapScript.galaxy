//--------------------------------------------------------------------------------------------------
// Trigger: Frost Activate
//--------------------------------------------------------------------------------------------------
bool lib3977487D_gt_FrostActivate_Func (bool testConds, bool runActions) {
    // Variable Declarations
    int lv_player;

    // Automatic Variable Declarations
    // Variable Initialization
    lv_player = UnitGetOwner(EventUnit());

    // Conditions
    if (testConds) {
        if (!(((UnitGetType(EventUnit()) == "WarPig") || (UnitGetType(EventUnit()) == "WarPig2")))) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    DialogControlFadeTransparency(lib3977487D_gv_frostOverlayDialogItem, PlayerGroupSingle(lv_player), (15.0 - lib3977487D_gv_frostTracker[lv_player]), 50.0);
    while ((lib3977487D_gv_frostTracker[lv_player] < 15.0) && (UnitIsAlive(EventUnit()) == true) && ((UnitHasBehavior(EventUnit(), "Frostbite") == true) || (UnitHasBehavior(EventUnit(), "Cold") == true))) {
        lib3977487D_gv_frostTracker[lv_player] += 0.0625;
        Wait(0.0625, c_timeGame);
    }
    return true;
}

//--------------------------------------------------------------------------------------------------
void lib3977487D_gt_FrostActivate_Init () {
    lib3977487D_gt_FrostActivate = TriggerCreate("lib3977487D_gt_FrostActivate_Func");
    TriggerAddEventUnitBehaviorChange(lib3977487D_gt_FrostActivate, null, "Frostbite", c_unitBehaviorChangeActivate);
    TriggerAddEventUnitBehaviorChange(lib3977487D_gt_FrostActivate, null, "Cold", c_unitBehaviorChangeActivate);
}

//--------------------------------------------------------------------------------------------------
// Trigger: Frost Deactivate
//--------------------------------------------------------------------------------------------------
bool lib3977487D_gt_FrostDeactivate_Func (bool testConds, bool runActions) {
    // Variable Declarations
    int lv_player;

    // Automatic Variable Declarations
    // Variable Initialization
    lv_player = UnitGetOwner(EventUnit());

    // Conditions
    if (testConds) {
        if (!(((UnitGetType(EventUnit()) == "WarPig") || (UnitGetType(EventUnit()) == "WarPig2")))) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    DialogControlFadeTransparency(lib3977487D_gv_frostOverlayDialogItem, PlayerGroupSingle(lv_player), (lib3977487D_gv_frostTracker[lv_player] / 4.0), 100.0);
    DialogControlFadeTransparency(lib3977487D_gv_heavyFrostOverlayDialogItem, PlayerGroupSingle(lv_player), ((lib3977487D_gv_frostTracker[lv_player] - 15.0) / 4.0), 100.0);
    while ((lib3977487D_gv_frostTracker[lv_player] > 0.0) && ((UnitHasBehavior(EventUnit(), "Frostbite") == false) || (UnitHasBehavior(EventUnit(), "Cold") == false))) {
        lib3977487D_gv_frostTracker[lv_player] -= 0.25;
        Wait(0.0625, c_timeGame);
    }
    return true;
}

