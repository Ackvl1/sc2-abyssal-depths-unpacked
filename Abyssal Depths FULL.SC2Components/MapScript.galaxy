//--------------------------------------------------------------------------------------------------
// Trigger: Enter Tar Pit
//--------------------------------------------------------------------------------------------------
bool lib3977487D_gt_EnterTarPit_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    // Conditions
    if (testConds) {
        if (!((UnitGetType(EventUnit()) != "Xenoray"))) {
            return false;
        }

        if (!((UnitGetType(EventUnit()) != "Xenowraith"))) {
            return false;
        }

        if (!((UnitGetType(EventUnit()) != "BroodlingEscort"))) {
            return false;
        }

        if (!((UnitGetType(EventUnit()) != "Overseer"))) {
            return false;
        }

        if (!((UnitGetType(EventUnit()) != "Oculus"))) {
            return false;
        }

        if (!((UnitGetType(EventUnit()) != "Queen3"))) {
            return false;
        }

        if (!((UnitGetType(EventUnit()) != "Mutalisk"))) {
            return false;
        }

        if (!((UnitGetType(EventUnit()) != "Devourer2"))) {
            return false;
        }

        if (!((UnitGetType(EventUnit()) != "LocustMP3"))) {
            return false;
        }

        if (!((UnitGetType(EventUnit()) != "Scourgeling"))) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    UnitBehaviorAdd(EventUnit(), "TarPit", EventUnit(), 1);
    return true;
}

//--------------------------------------------------------------------------------------------------
void lib3977487D_gt_EnterTarPit_Init () {
    lib3977487D_gt_EnterTarPit = TriggerCreate("lib3977487D_gt_EnterTarPit_Func");
    TriggerAddEventUnitRegion(lib3977487D_gt_EnterTarPit, null, RegionFromId(103), true);
}

//--------------------------------------------------------------------------------------------------
// Trigger: Leave Tar Pit
//--------------------------------------------------------------------------------------------------
bool lib3977487D_gt_LeaveTarPit_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    // Actions
    if (!runActions) {
        return true;
    }

    UnitBehaviorRemove(EventUnit(), "TarPit", 1);
    return true;
}

