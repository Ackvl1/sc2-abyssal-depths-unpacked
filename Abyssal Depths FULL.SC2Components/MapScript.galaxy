//--------------------------------------------------------------------------------------------------
// Trigger: Apply Christmas Hats
//--------------------------------------------------------------------------------------------------
bool lib3977487D_gt_ApplyChristmasHats_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    // Conditions
    if (testConds) {
        if (!((PlayerGroupHasPlayer(lib3977487D_gv_zombiePlayerGroup, UnitGetOwner(EventUnitCreatedUnit())) == false))) {
            return false;
        }

        if (!((UnitTypeTestAttribute(UnitGetType(EventUnitCreatedUnit()), c_unitAttributeBiological) == true))) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    UnitBehaviorAdd(EventUnitCreatedUnit(), "ChristmasHatEquipped", EventUnitCreatedUnit(), 1);
    return true;
}

