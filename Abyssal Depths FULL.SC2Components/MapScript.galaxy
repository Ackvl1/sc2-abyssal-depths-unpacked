void lib3977487D_gf_FixSpeedmultiplyingspeedthroughupgradesisbugged (int lp_player) {
    // Variable Declarations
    fixed lv_speed;

    // Automatic Variable Declarations
    // Variable Initialization
    lv_speed = 2.5;

    // Implementation
    if ((TechTreeUpgradeCount(lp_player, "AIAssistantEquipped", c_techCountQueuedOrBetter) == 1)) {
        lv_speed *= 1.05;
    }

    if ((TechTreeUpgradeCount(lp_player, "AutoTargetingSystemEquipped", c_techCountQueuedOrBetter) == 1) && (TechTreeUpgradeCount(lp_player, "AssaultRifleEquipped", c_techCountQueuedOrBetter) == 1)) {
        lv_speed *= 1.1;
    }

    if ((TechTreeUpgradeCount(lp_player, "CombatSuit", c_techCountQueuedOrBetter) == 1)) {
        lv_speed *= 1.125;
    }

    if ((TechTreeUpgradeCount(lp_player, "AdvancedCombatSuit", c_techCountQueuedOrBetter) == 1)) {
        lv_speed *= 1.2;
    }

    CatalogFieldValueSet(c_gameCatalogUnit, "WarPig", "Speed", lp_player, FixedToString(lv_speed, c_fixedPrecisionAny));
    CatalogFieldValueSet(c_gameCatalogUnit, "WarPig2", "Speed", lp_player, FixedToString(lv_speed, c_fixedPrecisionAny));
}

