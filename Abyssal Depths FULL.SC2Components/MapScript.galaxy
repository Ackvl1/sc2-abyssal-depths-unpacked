bool lib3977487D_gt_ThrustersAbort_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    // Actions
    if (!runActions) {
        return true;
    }

    Wait(0.3125, c_timeGame);
    do {
        if ((UnitGetPropertyFixed(EventUnit(), c_unitPropMovementSpeedCurrent, c_unitPropCurrent) < (UnitGetPropertyFixed(EventUnit(), c_unitPropMovementSpeed, c_unitPropCurrent) * 0.99))) {
            libNtve_gf_CreateModelAtPoint("AresThrustersScrapeSparks", libNtve_gf_PointFromXYZ(PointGetX(UnitGetPosition(EventUnit())), PointGetY(UnitGetPosition(EventUnit())), 1.0));
            SoundPlayAtPointForPlayer(SoundLink("Ares_Thrusters_Scrape", -1), EventPlayer(), PlayerGroupAll(), UnitGetPosition(EventUnit()), 0.0, 100.0, 0.0);
            Wait(0.125, c_timeGame);
        }
        else {
            Wait(0.625, c_timeGame);
        }
    }while ((PathingType(libNtve_gf_PointOffsetTowardsPoint(Point(PointGetX(UnitGetPosition(EventUnit())), PointGetY(UnitGetPosition(EventUnit()))), 1.5, EventUnitTargetPoint())) == c_pathingGround) && (UnitGetPropertyFixed(EventUnit(), c_unitPropMovementSpeedCurrent, c_unitPropCurrent) > (UnitGetPropertyFixed(EventUnit(), c_unitPropMovementSpeed, c_unitPropCurrent) * 0.6667)) && (UnitHasBehavior2(EventUnit(), "ThrustersSpeed") == true));
    if ((UnitHasBehavior2(EventUnit(), "ThrustersSpeed") == true)) {
        UnitBehaviorAdd(EventUnit(), "ThrustersAbort", EventUnit(), 1);
        libNtve_gf_CreateModelAtPoint("PhysicsImpactSparksLarge", libNtve_gf_PointOffsetTowardsPoint(libNtve_gf_PointFromXYZ(PointGetX(UnitGetPosition(EventUnit())), PointGetY(UnitGetPosition(EventUnit())), 1.0), 1.0, EventUnitTargetPoint()));
        SoundPlayAtPointForPlayer(SoundLink("Ares_Thrusters_Crash", -1), EventPlayer(), PlayerGroupAll(), UnitGetPosition(EventUnit()), 0.0, 250.0, 0.0);
    }

    return true;
}

