//--------------------------------------------------------------------------------------------------
// Trigger: Heavy Frost Activate
//--------------------------------------------------------------------------------------------------
bool lib3977487D_gt_HeavyFrostActivate_Func (bool testConds, bool runActions) {
    // Variable Declarations
    int lv_player;

    // Automatic Variable Declarations
    // Variable Initialization
    lv_player = UnitGetOwner(EventPlayerEffectUsedUnitImpact());

    // Conditions
    if (testConds) {
        if (!(((UnitGetType(EventPlayerEffectUsedUnitImpact()) == "WarPig") || (UnitGetType(EventPlayerEffectUsedUnitImpact()) == "WarPig2")))) {
            return false;
        }

        if (!((lib3977487D_gv_frostTracker[lv_player] >= 15.0))) {
            return false;
        }

        if (!((lib3977487D_gv_frostTracker[lv_player] < 60.0))) {
            return false;
        }

        if (!((UnitHasBehavior2(EventPlayerEffectUsedUnitImpact(), "HeavyFrost") == false))) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    UnitBehaviorAdd(EventPlayerEffectUsedUnitImpact(), "HeavyFrost", EventPlayerEffectUsedUnitLaunch(), 1);
    DialogControlFadeTransparency(lib3977487D_gv_frostOverlayDialogItem, PlayerGroupSingle(lv_player), (60.0 - lib3977487D_gv_frostTracker[lv_player]), 0.0);
    DialogControlFadeTransparency(lib3977487D_gv_heavyFrostOverlayDialogItem, PlayerGroupSingle(lv_player), (60.0 - lib3977487D_gv_frostTracker[lv_player]), 50.0);
    while ((lib3977487D_gv_frostTracker[lv_player] < 60.0) && ((UnitHasBehavior(EventPlayerEffectUsedUnitImpact(), "Frostbite") == true) || (UnitHasBehavior(EventPlayerEffectUsedUnitImpact(), "Cold") == true))) {
        lib3977487D_gv_frostTracker[lv_player] += 0.0625;
        Wait(0.0625, c_timeGame);
    }
    UnitBehaviorRemove(EventPlayerEffectUsedUnitImpact(), "HeavyFrost", 1);
    return true;
}

