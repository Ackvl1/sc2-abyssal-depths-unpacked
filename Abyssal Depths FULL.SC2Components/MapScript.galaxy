bool lib3977487D_gt_TestSpawnAttackDrones_Func (bool testConds, bool runActions) {
    // Variable Declarations
    unit lv_marine;

    // Automatic Variable Declarations
    // Variable Initialization

    // Conditions
    if (testConds) {
        if (!((PlayerHandle(EventPlayer()) == ""))) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    lv_marine = UnitGroupUnit(UnitGroup("WarPig", EventPlayer(), RegionEntireMap(), UnitFilter(0, 0, (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))), 0), 1);
    libNtve_gf_CreateUnitsWithDefaultFacing(1, "ACGriffon", 0, EventPlayer(), Point(PointGetX(UnitGetPosition(lv_marine)), (PointGetY(UnitGetPosition(lv_marine)) + 2.0)));
    UnitCreateEffectUnit(lv_marine, "FollowApplyKinetic", UnitLastCreated());
    UnitCreateEffectUnit(lv_marine, "RotateApplyKinetic", UnitLastCreated());
    libNtve_gf_CreateUnitsWithDefaultFacing(1, "ACGriffon", 0, EventPlayer(), Point((PointGetX(UnitGetPosition(lv_marine)) - 1.7321), (PointGetY(UnitGetPosition(lv_marine)) - 1.0)));
    UnitCreateEffectUnit(lv_marine, "FollowApplyKinetic", UnitLastCreated());
    UnitCreateEffectUnit(lv_marine, "RotateApplyKinetic", UnitLastCreated());
    libNtve_gf_CreateUnitsWithDefaultFacing(1, "ACGriffon", 0, EventPlayer(), Point((PointGetX(UnitGetPosition(lv_marine)) + 1.7321), (PointGetY(UnitGetPosition(lv_marine)) - 1.0)));
    UnitCreateEffectUnit(lv_marine, "FollowApplyKinetic", UnitLastCreated());
    UnitCreateEffectUnit(lv_marine, "RotateApplyKinetic", UnitLastCreated());
    UnitWeaponRemove(lv_marine, "KelmorianMinerGaussRifle");
    return true;
}

