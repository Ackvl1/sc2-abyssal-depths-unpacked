//--------------------------------------------------------------------------------------------------
// Trigger: ZombieResponseConvo
//--------------------------------------------------------------------------------------------------
bool lib3977487D_gt_ZombieResponseConvo_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    // Conditions
    if (testConds) {
        if (!((UnitGetOwner(EventUnitTarget()) == 10))) {
            return false;
        }

        if (!((UnitTypeTestAttribute(UnitGetType(EventUnitTarget()), c_unitAttributeBiological) == true))) {
            return false;
        }

        if (!((EventPlayer() == lib3977487D_gv_zombiePlayer))) {
            return false;
        }

        if (!((UnitHasBehavior2(EventUnit(), "ZombieResponseAlertCooldown") == false))) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    TriggerEnable(TriggerGetCurrent(), false);
    TimerStart(lib3977487D_gv_zombieResponseConvoTimer, lib3977487D_gv_zOMBIE_ALERT_REFRESH_TIME, false, c_timeReal);
    lib3977487D_gf_Speak(EventUnitTarget(), lib3977487D_gv_zombieAlertLines[RandomInt(0, (lib3977487D_gv_nUMBER_OF_ZOMBIE_ALERT_LINES - 1))]);
    return true;
}

